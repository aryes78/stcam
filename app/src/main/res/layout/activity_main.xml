<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121316">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Samsung S24 Sztereó 3D"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tvDeviceInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Eszköz információ..."
            android:textSize="13sp"
            android:textColor="#9CA3AF"
            android:layout_marginBottom="16dp" />

        <!-- Élő Kamera Információs Kártya az S24-hez -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E293B"
            android:padding="14dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DETEKTÁLT HARDVER KAMERÁK (S24):"
                android:textColor="#38BDF8"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvCameraDiagInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kamerák felderítése folyamatban..."
                android:textColor="#E2E8F0"
                android:textSize="12sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <Button
            android:id="@+id/btnOpenStereoCam"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="1. Sztereó Fényképező (Fotó és SBS 3D)"
            android:backgroundTint="#059669"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="14dp" />

        <Button
            android:id="@+id/btnOpenStereoVideo"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="2. Sztereó Videófelvevő (Full HD + 2.79x Zoom)"
            android:backgroundTint="#0284C7"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tipp: A sztereó felvételhez tartsa a telefont vízszintesen! A főkamera (2.79x crop) és a 3x telekamera szimultán rögzít."
            android:textSize="12sp"
            android:textColor="#9CA3AF"
            android:gravity="center" />

    </LinearLayout>
</ScrollView>
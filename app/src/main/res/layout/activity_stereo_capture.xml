<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Dupla előnézet: Bal oldal Főkamera előnézet, Jobb oldal Telekamera előnézet -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <SurfaceView
            android:id="@+id/surfaceViewMain"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <View
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:background="#33FFFFFF" />

        <SurfaceView
            android:id="@+id/surfaceViewTele"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- Felső állapotkijelző -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="16dp"
        android:background="#80000000"
        android:padding="8dp"
        android:text="S24 Sztereó készen áll (Tartsa vízszintesen!)"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <!-- Jobb oldali Exponáló sáv -->
    <RelativeLayout
        android:layout_width="100dp"
        android:layout_height="match_parent"
        android:layout_alignParentEnd="true"
        android:background="#66000000"
        android:gravity="center">

        <ImageButton
            android:id="@+id/btnShutter"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@android:drawable/btn_default"
            android:backgroundTint="#EF4444"
            android:contentDescription="Exponálás" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </RelativeLayout>

</RelativeLayout>